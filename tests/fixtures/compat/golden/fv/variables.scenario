# Issue 4: the format variables of tmux 3.7b's format_table that grofe
# answers from state it keeps: the client's view of the session and window,
# the cell sizes, the top buffer, the copy-mode cursor's line and link, and
# the status row under the mouse, the running command, the dead pane's
# signal, the attach times, mode 2026 and output unseen in a mode.
$ new-session -d -s main -x 80 -y 24 'printf "first line\n\033]8;;http://example.com/\007link\033]8;;\007\n"; cat'
$ new-window -d -t main cat
$ run-shell 'sh {fixtures}/wait.sh shows main:1 link'
$ display-message -p -t main:1 'active=[#{session_active}] clients=[#{window_active_clients}] list=[#{window_active_clients_list}] bigger=[#{window_bigger}] offset=[#{window_offset_x},#{window_offset_y}]'
$ display-message -p -t main:1 'window cell=[#{window_cell_width}x#{window_cell_height}] client cell=[#{client_cell_width}x#{client_cell_height}]'
$ display-message -p -t main 'buffer=[#{buffer_full}]'
$ set-buffer 'hello world'
$ display-message -p -t main 'buffer=[#{buffer_full}]'
$ display-message -p -t main 'command=[#{command}] config=[#{m:*/compat/*-defaults.*,#{config_files}}] last attached=[#{session_last_attached}]'
$ display-message -p -t main 'sixel=[#{sixel_support}]'
$ if -F '#{==:#{command},if-shell}' 'display -p if=[yes]' 'display -p if=[no]'
$ set-window-option -F -t main:1 @cmd 'set=[#{command}]'
$ show-window-options -v -t main:1 @cmd
$ new-window -d -P -F 'printed=[#{command}]' -t main:8 cat
$ kill-window -t main:8
$ new-window -d -t main:5 'sleep 100000'
$ set -w -t main:5 remain-on-exit on
$ run-shell 'sh {fixtures}/wait.sh format main:5 "##{?pane_pid,1,0}" 1'
$ run-shell -t main:5 'kill -TERM #{pane_pid}'
$ run-shell 'sh {fixtures}/wait.sh format main:5 "##{pane_dead}" 1'
$ display-message -p -t main:5 'dead=[#{pane_dead}] signal=[#{pane_dead_signal}] status=[#{pane_dead_status}]'
$ new-window -d -t main:6 'while :; do printf "\033[?2026h"; : > "$HOME/sync6"; sleep 0.02; done'
$ run-shell 'sh {fixtures}/wait.sh seen main:6 "sync=[##{synchronized_output_flag}]" "sync=[1]"'
$ display-message -p -t main:2 'sync=[#{synchronized_output_flag}]'
$ kill-window -t main:6
client 80x24 attach -t main
$ list-clients -F 'command=[#{command}] active=[#{session_active}] created=[#{?#{e|>:#{client_created},0},set,unset}] bigger=[#{window_bigger}] clients=[#{window_active_clients}]'
$ display-message -p -t main 'last attached=[#{?#{e|>:#{session_last_attached},0},set,unset}]'
$ display-message -p -t main:1 'active=[#{session_active}] clients=[#{window_active_clients}] list=[#{window_active_clients_list}] bigger=[#{window_bigger}] offset=[#{window_offset_x},#{window_offset_y}]'
$ display-message -p -t main:2 'clients=[#{window_active_clients}] list=[#{window_active_clients_list}]'
$ display-message -p -t main:1 'window cell=[#{window_cell_width}x#{window_cell_height}]'
$ new-session -d -s other -x 80 -y 24 cat
$ display-message -p -t other 'active=[#{session_active}]'
$ set -g mouse on
$ bind -n MouseDown1Status set -gF @ms 'status line [#{mouse_status_line}]'
$ bind -n MouseDown1StatusLeft set -gF @ms 'status left [#{mouse_status_line}]'
$ bind -n MouseDown1Pane set -gF @ms 'pane [#{mouse_status_line}]'
$ bind -n MouseUp1Pane set -g @up pane
keys Escape '[<0;5;24M'
keys Escape '[<0;5;24m'
$ run-shell 'sh {fixtures}/wait.sh format main "##{@ms}" "status left [0]"'
$ show -gv @ms
keys Escape '[<0;12;24M'
keys Escape '[<0;12;24m'
$ run-shell 'sh {fixtures}/wait.sh format main "##{@ms}" "status line [0]"'
$ show -gv @ms
keys Escape '[<0;5;5M'
keys Escape '[<0;5;5m'
$ run-shell 'sh {fixtures}/wait.sh format main "##{@up}" pane'
$ show -gv @ms
$ copy-mode -t main:1
$ send-keys -X -t main:1 top-line
$ display-message -p -t main:1 'line=[#{copy_cursor_line}] link=[#{copy_cursor_hyperlink}]'
$ send-keys -X -t main:1 cursor-down
$ display-message -p -t main:1 'line=[#{copy_cursor_line}] link=[#{copy_cursor_hyperlink}]'
$ send-keys -X -t main:1 cancel
$ new-window -d -t main:7 'while [ ! -e go ]; do sleep 0.1; done; echo hi; cat'
$ copy-mode -t main:7
$ display-message -p -t main:7 'unseen=[#{pane_unseen_changes}]'
$ run-shell 'touch go; sh {fixtures}/wait.sh format main:7 "##{pane_unseen_changes}" 1'
$ display-message -p -t main:7 'unseen=[#{pane_unseen_changes}]'
$ send-keys -X -t main:7 cancel
$ display-message -p -t main:7 'unseen=[#{pane_unseen_changes}]'
$ copy-mode -t main:7
$ display-message -p -t main:7 'unseen=[#{pane_unseen_changes}]'
$ send-keys -X -t main:7 cancel
$ resize-window -t main:1 -x 100 -y 40
$ display-message -p -t main:1 'bigger=[#{window_bigger}] offset=[#{window_offset_x},#{window_offset_y}]'
$ new-window -d -t main:3 cat
$ resize-window -t main:3 -x 120 -y 60
$ respawn-pane -k -t main:3 'printf "\033[55;100H"; cat'
$ run-shell 'sh {fixtures}/wait.sh format main:3 "##{cursor_y}" 54'
$ select-window -t main:3
$ display-message -p -t main:3 'bigger=[#{window_bigger}] offset=[#{window_offset_x},#{window_offset_y}]'
